# ═══════════════════════════════════════════════════════════════════
# AI Proctor Browser — Backend Environment Variables
# Copy this file to .env and fill in your actual values.
# NEVER commit the real .env file to version control.
# ═══════════════════════════════════════════════════════════════════

# ─── PostgreSQL connection ─────────────────────────────────────────
DB_HOST=localhost
DB_PORT=5432
DB_NAME=proctordb
DB_USER=your_postgres_username
DB_PASSWORD=your_postgres_password
DB_SSL=false

# ─── Server ────────────────────────────────────────────────────────
PROCTOR_PORT=4000

# ─── Security ──────────────────────────────────────────────────────
# Comma-separated list of allowed CORS origins
# Electron file:// is always allowed automatically
CORS_ORIGINS=http://localhost:4000,http://127.0.0.1:4000

# Secret used to sign/verify kiosk mode attestations from the Electron app
# Change this to a long random string in production!
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
KIOSK_SECRET=change-this-to-a-long-random-secret-in-production

# ─── Redis (caching & Socket.IO scaling) ───────────────────────────
# Set REDIS_ENABLED=false to run without Redis (app still works, just no caching)
REDIS_ENABLED=false
REDIS_URL=redis://127.0.0.1:6379
